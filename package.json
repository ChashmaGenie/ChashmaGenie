{
  "name": "chashmagenie",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:api": "wrangler pages dev dist --kv CHASHMA_KV --port 8788 --persist-to .wrangler/state",
    "cf:dev": "npm run build && npm run dev:api",
    "cf:deploy": "npm run build && wrangler pages deploy dist --project-name chashmagenie",
    "seed:img": "node scripts/gen-seed-svgs.mjs",
    "test": "node scripts/test-rx.mjs && node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "wrangler": "^3.99.0"
  }
}
